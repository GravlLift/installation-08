// resources.rc - the app's PE resources, GENERATED by tools\resources.ps1 from the
// appDisplayName constant (window.go) and the Version default (serve.go). Do not edit
// it by hand: rename the app by editing the constant, then rerun the script.

// The app manifest: per-monitor-v2 DPI awareness, Common Controls v6, Windows 10.
1 24 "app.manifest"

// App icon: add here, once the name and the artwork are chosen, as
// 1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Infinite Theater 3D"
            VALUE "FileVersion", "0.1.0-dev"
            VALUE "LegalCopyright", "Licensed under AGPL-3.0; see NOTICE.md."
            VALUE "ProductName", "Infinite Theater 3D"
            VALUE "ProductVersion", "0.1.0-dev"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
